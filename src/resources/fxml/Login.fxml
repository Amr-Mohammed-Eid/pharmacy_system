<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="com.pharmacy.controller.LoginController" 
            xmlns:fx="http://javafx.com/fxml" stylesheets="/css/styles.css">
    
    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="login-panel">
            <padding>
                <Insets top="50" right="50" bottom="50" left="50" />
            </padding>
            
            <Label text="Pharmacy Management System" styleClass="title-label"/>
            <Label text="Login" styleClass="subtitle-label"/>
            
            <Separator />
            
            <GridPane hgap="10" vgap="10" alignment="CENTER">
                <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="usernameField" promptText="Enter username" 
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />
                
                <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <PasswordField fx:id="passwordField" promptText="Enter password" 
                               GridPane.rowIndex="1" GridPane.columnIndex="1" />
            </GridPane>
            
            <Button fx:id="loginButton" text="Login" onAction="#handleLogin" 
                    styleClass="primary-button" />
            
            <Label text="Default credentials: admin / admin123" styleClass="info-label"/>
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" spacing="10" styleClass="footer">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
            <Label text="© 2025 Pharmacy Management System" />
        </HBox>
    </bottom>
    
</BorderPane>
